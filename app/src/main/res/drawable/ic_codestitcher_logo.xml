    <!-- Left Code Bracket Stitch (<) -->
    <path
        android:pathData="M38,30 L22,48 L38,66"
        android:strokeWidth="6"
        android:strokeColor="#6366F1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Right Code Bracket Stitch (>) -->
    <path
        android:pathData="M58,30 L74,48 L58,66"
        android:strokeWidth="6"
        android:strokeColor="#06B6D4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Dynamic Stitch Thread connecting the code brackets (/) -->
    <path
        android:pathData="M55,26 L41,70"
        android:strokeWidth="5"
        android:strokeColor="#10B981"
